// A stable target preserves positions through rename/reopen and temporary
// absence. Discovering numbered backups separately would replay their records.
loki.source.file "application" {
  targets = [{
    __path__ = sys.env("GLAMDB_LOG_DIRECTORY") + "/glamdb.jsonl",
    service = "glamdb",
    environment = sys.env("GLAMDB_ENVIRONMENT"),
  }]
  tail_from_end = false
  forward_to = [loki.process.application.receiver]
}
