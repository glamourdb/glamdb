  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Scope and missing data",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Missing collectors, unsupported kernel fields, idle histogram quantiles, and unconfigured endpoints remain **No data**. No panel substitutes zero or infers native readiness. See `docs/development/MONITORING.md` for sources, prerequisites, proxy meanings and deployment steps."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Live pod CPU",
      "description": "5-minute CPU seconds/second, one core = 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(glamdb:pod_cpu_usage_cores:rate5m{cluster=~\"$cluster\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}}{{instance}} {{operation}} {{phase}} {{outcome}} {{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "No data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
