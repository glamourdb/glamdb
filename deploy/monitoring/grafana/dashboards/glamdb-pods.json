{
  "uid": "glamdb-pods",
  "title": "GlamDB · Pods and containers",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "glamdb",
    "provisioned"
  ],
  "editable": false,
  "timezone": "browser",
