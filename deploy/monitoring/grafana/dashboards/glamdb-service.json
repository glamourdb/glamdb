    {
      "id": 16,
      "type": "timeseries",
      "title": "Podset PVC free fraction p50",
      "description": "Per pod least-free mounted PVC, median over immediate controller. CSI+kubelet stats+KSM required. No ephemeral-quota substitution.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "glamdb:podset_pvc_available:p50{cluster=~\"$cluster\"}",
          "legendFormat": "{{operation}} {{outcome}} {{route}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Podset PVC free fraction p100",
      "description": "Most-free pod in immediate controller; inspect p00 for worst pod. No data without actual CSI/KSM sources.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "glamdb:podset_pvc_available:p100{cluster=~\"$cluster\"}",
