        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "glamdb_operations_in_flight{cluster=~\"$cluster\",service=~\"$service\"}",
          "legendFormat": "{{operation}} {{outcome}} {{route}} {{stage}}"
        }
