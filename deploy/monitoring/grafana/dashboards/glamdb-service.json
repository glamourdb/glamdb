      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "glamdb_admission_owned_input_bytes{cluster=~\"$cluster\",service=~\"$service\"}",
          "legendFormat": "{{operation}} {{outcome}} {{route}} {{stage}}"
