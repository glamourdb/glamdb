    {
      "id": 6,
      "title": "All checks: 0 OK / 1 WARN / 2 ALARM / 3 NODATA",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "noValue": "\u2014",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "WARN",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "ALARM",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "NODATA",
                  "color": "gray",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "glamdb_alert_state",
          "legendFormat": "{{route}} {{status_class}} {{job}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "check": 0,
              "service": 1,
              "node": 2,
              "Value": 3
            },
            "renameByName": {
              "Value": "State"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Native HTTP requests / second",
      "type": "timeseries",
      "datasource": {
