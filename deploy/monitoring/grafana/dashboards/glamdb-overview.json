{
  "uid": "glamdb-overview",
  "title": "GlamDB \u00b7 Live overview",
  "tags": [
    "glamdb",
    "live"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Monitoring scope",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Real macOS host + Podman Linux VM + native persistent DB + authenticated gateway. Sources and layers stay separate. States: **0 OK \u00b7 1 WARN \u00b7 2 ALARM \u00b7 3 NODATA**. Kubernetes/PVC fields require a real cluster. Logs omit request bodies and credentials. HTTP cancellation does not establish commit outcome."
      }
    },
    {
      "id": 2,
      "title": "Native engine ready",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#D61F87"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "glamdb_server_ready{job=\"glamdb-core\"}",
          "legendFormat": "{{route}} {{status_class}} {{job}}",
          "instant": true
        }
      ]
    },
