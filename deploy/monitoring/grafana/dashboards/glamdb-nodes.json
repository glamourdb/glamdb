    {
      "id": 8,
      "type": "timeseries",
      "title": "Node network received/transmitted",
      "description": "Filter virtual interfaces in Explore when diagnosing a physical link; never sum all links to infer wire traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])",
          "legendFormat": "{{pod}}{{instance}} {{operation}} {{phase}} {{outcome}} {{device}}",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])",
          "legendFormat": "transmit {{instance}} {{device}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "No data",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Node established TCP",
      "description": "Linux network namespace Tcp CurrEstab counts ESTABLISHED and CLOSE-WAIT, not a pure ESTABLISHED count.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "node_netstat_Tcp_CurrEstab{cluster=~\"$cluster\",instance=~\"$instance\"}",
          "legendFormat": "{{pod}}{{instance}} {{operation}} {{phase}} {{outcome}} {{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "min": 0
