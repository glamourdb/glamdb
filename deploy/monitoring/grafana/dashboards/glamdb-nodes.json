      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{cluster=~\"$cluster\",instance=~\"$instance\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint=~\"$mountpoint\"} / node_filesystem_size_bytes{cluster=~\"$cluster\",instance=~\"$instance\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint=~\"$mountpoint\"}",
