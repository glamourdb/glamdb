    {
      "id": 12,
      "type": "timeseries",
      "title": "Top disks: busy time",
      "description": "Linux io_ticks wall-time busy fraction. Modern parallel devices can saturate below/above assumptions; not a universal throughput limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(10,glamdb:node_disk_busy:ratio5m{cluster=~\"$cluster\",instance=~\"$instance\",device=~\"$device\"})",
          "legendFormat": "{{pod}}{{instance}} {{operation}} {{phase}} {{outcome}} {{device}}",
          "refId": "A"
