    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU busy",
      "description": "Average across actual logical CPUs; busy = 1 - idle. Darwin has no Linux iowait mode.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{job=\"macos-node\",instance=~\"$instance\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} busy",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data"
        },
        "overrides": []
      },
