{
  "uid": "glamdb-macos-node",
  "title": "GlamDB · macOS host",
  "description": "Official node_exporter 1.12.1 runs on the actual Darwin arm64 Mac, separate from the Linux Podman VM. Internal memory is resident anonymous pages from Mach internal_page_count (the same source as vm_stat Anonymous pages); compressed memory is separate. Active/inactive, anonymous, wired and purgeable categories overlap: never add these series. Free memory includes speculative pages. Unsupported thermal, Linux MemAvailable/iowait/PSI/major-fault and disk queue/busy metrics are unavailable. Disk service time is a driver timing proxy. APFS volumes can share capacity; do not sum them.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "tags": [
    "glamdb",
    "local",
    "standard-collectors"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(node_uname_info{job=\"macos-node\"},instance)",
        "query": {
          "query": "label_values(node_uname_info{job=\"macos-node\"},instance)",
          "refId": "instance"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Source and scope",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Official node_exporter 1.12.1 runs on the actual Darwin arm64 Mac, separate from the Linux Podman VM. Internal memory is resident anonymous pages from Mach internal_page_count (the same source as vm_stat Anonymous pages); compressed memory is separate. Active/inactive, anonymous, wired and purgeable categories overlap: never add these series. Free memory includes speculative pages. Unsupported thermal, Linux MemAvailable/iowait/PSI/major-fault and disk queue/busy metrics are unavailable. Disk service time is a driver timing proxy. APFS volumes can share capacity; do not sum them."
      }
    },
