{
  "uid": "glamdb-cgroup-v2",
  "title": "GlamDB · exact Podman cgroups",
  "description": "Official cgroup-exporter 0.3.3 reads only read-only VM cgroup-v2 sysfs without privilege, API socket or host namespaces. Only direct-run machine.slice/libpod-*.scope/container and Quadlet system.slice/*.service/libpod-payload-* leaves are selected. Names join actual Podman inventory via the first 12 hex ID characters; this is a single-VM mapping. No Kubernetes labels or pod-parent equivalence. Anonymous/file/unevictable are literal memory.stat categories, not RSS renames; file includes tmpfs/shared memory and unevictable includes more than mlock. PSI some/full records time with at least one/all runnable tasks stalled; it is not unconstrained demand or generic I/O latency. The exporter can log partial collection errors while HTTP stays healthy: absent fields remain No data, and the presence panel must be checked.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "tags": [
    "glamdb",
    "local",
    "standard-collectors"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(podman_container_info{job=\"podman\"},name)",
        "query": {
          "query": "label_values(podman_container_info{job=\"podman\"},name)",
          "refId": "container"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Source and scope",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Official cgroup-exporter 0.3.3 reads only read-only VM cgroup-v2 sysfs without privilege, API socket or host namespaces. Only direct-run machine.slice/libpod-*.scope/container and Quadlet system.slice/*.service/libpod-payload-* leaves are selected. Names join actual Podman inventory via the first 12 hex ID characters; this is a single-VM mapping. No Kubernetes labels or pod-parent equivalence. Anonymous/file/unevictable are literal memory.stat categories, not RSS renames; file includes tmpfs/shared memory and unevictable includes more than mlock. PSI some/full records time with at least one/all runnable tasks stalled; it is not unconstrained demand or generic I/O latency. The exporter can log partial collection errors while HTTP stays healthy: absent fields remain No data, and the presence panel must be checked."
      }
    },
