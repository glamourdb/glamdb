[Unit]
Description=GlamDB private read-only Quadlet cgroup v2 metrics collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/podman start glamdb-collectors-cgroup-systemd
ExecStop=/usr/bin/podman stop --ignore --time 10 glamdb-collectors-cgroup-systemd
TimeoutStartSec=60
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
