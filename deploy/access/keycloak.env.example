# Private runtime file: owner deployment service user, mode0600; never commit populated copies.
# Must match the password of the dedicated, nonsuperuser PostgreSQL keycloak role.
KC_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ASCII_SECRET
# Remove both bootstrap settings after the first permanent administrator is ready.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ASCII_SECRET
