# Nonsecret interpolation only. Use absolute, dedicated Linux paths outside the UI.
# Set UID/GID to the existing service account; do not change file ownership to an
# arbitrary image default. Catalog/secrets are checked against the process UID.
GLAMDB_UID=10001
GLAMDB_GID=10001
GLAMDB_PRIVATE_DIR=/var/lib/glamdb/access/private
GLAMDB_STATE_DIR=/var/lib/glamdb/access/state
GLAMDB_UI_DIR=/opt/glamdb/ui
GLAMDB_SITE_HOST=workbench.example.com
GLAMDB_IDP_HOST=login.example.com
GLAMDB_ACME_EMAIL=operations@example.com
GLAMDB_OBSERVABILITY_NETWORK=glamdb-observability
