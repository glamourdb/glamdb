@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(prometheus-cpp 1.3.0 EXACT CONFIG)
find_dependency(SQLite3 CONFIG)
find_dependency(Arrow 25 CONFIG)
find_dependency(iceberg CONFIG)
if(@GLAMDB_BUILD_STORAGE@)
    find_dependency(Parquet 25 CONFIG)
    find_dependency(Iceberg CONFIG)
    find_dependency(ZLIB)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/GlamDBTargets.cmake")
check_required_components(GlamDB)
