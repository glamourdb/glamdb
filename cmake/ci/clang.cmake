# CI toolchain, also propagated to ExternalProject dependencies and installed consumers.
set(CMAKE_C_COMPILER clang-18 CACHE FILEPATH "")
set(CMAKE_CXX_COMPILER clang++-18 CACHE FILEPATH "")
set(CMAKE_POSITION_INDEPENDENT_CODE ON CACHE BOOL "")
set(CMAKE_CXX_SCAN_FOR_MODULES OFF CACHE BOOL "")

set(profile "$ENV{GLAMDB_CI_PROFILE}")
if(NOT profile MATCHES "^(normal|asan|ubsan|msan|tsan|lsan)$")
    message(FATAL_ERROR "Set GLAMDB_CI_PROFILE to normal, asan, ubsan, msan, tsan, or lsan")
endif()
set(instrument ON)
if("$ENV{GLAMDB_CI_PHASE}" STREQUAL "deps" AND NOT profile MATCHES "^(msan|tsan)$")
    set(instrument OFF)
endif()
set(flags "-gline-tables-only -fno-omit-frame-pointer")
if(instrument AND NOT profile STREQUAL "normal")
    if(profile STREQUAL "asan")
        set(sanitizer address)
        # Dependencies use an ordinary libc++ prefix (see BUILDING.md).
        string(APPEND flags " -D_LIBCPP_HAS_NO_ASAN")
    elseif(profile STREQUAL "ubsan")
        set(sanitizer undefined)
    elseif(profile STREQUAL "msan")
        set(sanitizer memory)
        # A linked mimalloc runs its initializer before Arrow selects a memory pool.
        # Use MSan's intercepted system allocator throughout this dependency build.
        set(ARROW_MIMALLOC OFF CACHE BOOL "Disable custom allocators for MSan" FORCE)
        set(ARROW_JEMALLOC OFF CACHE BOOL "Disable custom allocators for MSan" FORCE)
        string(APPEND flags " -fsanitize-memory-track-origins=2 -DZSTD_DISABLE_ASM")
    elseif(profile STREQUAL "tsan")
        set(sanitizer thread)
    else()
        set(sanitizer leak)
    endif()
    string(APPEND flags " -fsanitize=${sanitizer} -fno-sanitize-recover=all")
endif()
set(CMAKE_C_FLAGS_INIT "${flags}")
set(CMAKE_CXX_FLAGS_INIT "${flags} -stdlib=libc++")

set(runtime "$ENV{GLAMDB_CI_RUNTIME_PREFIX}")
if(profile MATCHES "^(msan|tsan)$" AND NOT EXISTS "${runtime}/include/c++/v1/__config")
    message(FATAL_ERROR "${profile} requires an instrumented GLAMDB_CI_RUNTIME_PREFIX")
endif()
if(runtime)
    set(CMAKE_CXX_FLAGS_INIT "${flags} -nostdinc++ -isystem ${runtime}/include/c++/v1")
    set(CMAKE_EXE_LINKER_FLAGS_INIT "-stdlib=libc++ -L${runtime}/lib -Wl,-rpath,${runtime}/lib")
    set(CMAKE_SHARED_LINKER_FLAGS_INIT "-stdlib=libc++ -L${runtime}/lib -Wl,-rpath,${runtime}/lib")
endif()
if(profile MATCHES "^(msan|tsan)$")
    string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " -pie")
    # Iceberg/Avro normally find system zlib. Use the instrumented copy instead.
    set(ZLIB_ROOT "$ENV{GLAMDB_CI_PREFIX}" CACHE PATH "")
    set(ZLIB_INCLUDE_DIR "$ENV{GLAMDB_CI_PREFIX}/include" CACHE PATH "")
    set(ZLIB_LIBRARY "$ENV{GLAMDB_CI_PREFIX}/lib/libz.a" CACHE FILEPATH "")
    set(zstd_DIR "$ENV{GLAMDB_CI_PREFIX}/lib/cmake/zstd" CACHE PATH "")
    set(CMAKE_DISABLE_FIND_PACKAGE_Snappy ON CACHE BOOL "")
    foreach(dependency IN ITEMS avro-cpp nanoarrow croaring utf8proc spdlog)
        set(CMAKE_DISABLE_FIND_PACKAGE_${dependency} ON CACHE BOOL "")
    endforeach()
else()
    # Avoid Ubuntu libc++abi's independently reproduced ASan exception mismatch.
    string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " -static-libstdc++")
endif()
